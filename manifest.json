{
    "manifest_version": 3,
    "name": "读享收藏夹duxiang.ai",
    "version": "1.1",
    "description": "一个同步阅读内容的工具.",
    "permissions": [
        "activeTab",
        "scripting",
        "commands",
        "tabs",
        "storage",
        "bookmarks",
        "contextMenus",
        "notifications"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "popup.html",
      "default_width": 400,
      "default_height": 650,
      "default_icon": {
        "16": "icons/octpus_blue_16.png",
        "48": "icons/octpus_blue_48.png",
        "128": "icons/octpus_blue_128.png"
      }
    },
    "commands": {
      "save_reading_url": {
        "suggested_key": {
          "default": "Shift+Alt+S"
        },
        "description": "收藏当前Tab网址"
      },
      "open_groups": {
        "suggested_key": {
          "default": "Shift+Alt+G"
        },
        "description": "打开分组管理页面"
      },
      "open_selections": {
        "suggested_key": {
          "default": "Shift+Alt+K"
        },
        "description": "打开选中文本页面"
      },
      "save_selection": {
        "suggested_key": {
          "default": "Shift+Alt+X"
        },
        "description": "保存当前页面选中的文本"
      }
    },
    "icons": {
      "16": "icons/octpus_blue_16.png",
      "48": "icons/octpus_blue_48.png",
      "128": "icons/octpus_blue_128.png"
    }
  }